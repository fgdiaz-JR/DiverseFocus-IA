# ─────────────────────────────────────────────────────────────────────────────
# DiverseFocus-IA — Environment Variables Template
# Copy this file to .env and fill in your values before running.
#
#   cp .env.example .env
#
# WARNING: Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Gemini AI ──────────────────────────────────────────────────────────
# Obtain your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_ai_studio_key_here

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -hex 32
JWT_SECRET=change_this_to_a_random_256_bit_secret

# ── Whisper Configuration ─────────────────────────────────────────────────────
# Available sizes: tiny | base | small | medium | large
# Larger models are more accurate but require more RAM/CPU.
WHISPER_MODEL=base

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite async URL (default). For production consider PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./data/users.db

# ── Internal Service URLs (Docker Compose) ────────────────────────────────────
# These point to the container service names defined in docker-compose.yml.
# Change only if you rename services or use external hosts.
AI_INFERENCE_URL=http://ai-inference:8001
VOICE_VIDEO_URL=http://voice-video:8002
USER_PROFILE_URL=http://user-profile:8003

# ── MLflow Tracking ───────────────────────────────────────────────────────────
# Set to a remote server URL when running in a team environment.
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT=diversefocus-simplification

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
