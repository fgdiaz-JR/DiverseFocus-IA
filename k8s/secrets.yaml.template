# ─────────────────────────────────────────────────────────────────────────────
# Kubernetes Secret Template for DiverseFocus-IA
#
# DO NOT commit real secrets. This file shows the structure only.
# To create the real secret:
#
#   kubectl create secret generic diversefocus-secrets \
#     --namespace diversefocus \
#     --from-literal=GEMINI_API_KEY=<your-key> \
#     --from-literal=JWT_SECRET=<your-secret> \
#     --from-literal=WHISPER_MODEL=base \
#     --from-literal=AI_INFERENCE_URL=http://ai-inference:8001 \
#     --from-literal=VOICE_VIDEO_URL=http://voice-video:8002 \
#     --from-literal=USER_PROFILE_URL=http://user-profile:8003
#
# Or use a sealed-secrets / external-secrets operator in production.
# ─────────────────────────────────────────────────────────────────────────────
apiVersion: v1
kind: Secret
metadata:
  name: diversefocus-secrets
  namespace: diversefocus
  labels:
    app.kubernetes.io/name: diversefocus-ia
type: Opaque
stringData:
  # Google AI Studio API key — obtain from https://aistudio.google.com/app/apikey
  GEMINI_API_KEY: "REPLACE_WITH_YOUR_GEMINI_API_KEY"

  # JWT signing secret — generate with: openssl rand -hex 32
  JWT_SECRET: "REPLACE_WITH_A_RANDOM_256_BIT_SECRET"

  # Whisper model size: tiny | base | small | medium | large
  WHISPER_MODEL: "base"

  # Internal service URLs (cluster-DNS names — do not change unless service names change)
  AI_INFERENCE_URL: "http://ai-inference:8001"
  VOICE_VIDEO_URL: "http://voice-video:8002"
  USER_PROFILE_URL: "http://user-profile:8003"

  # MLflow tracking server (optional — set if using centralized MLflow)
  MLFLOW_TRACKING_URI: "http://mlflow:5000"

  # Logging level: DEBUG | INFO | WARNING | ERROR
  LOG_LEVEL: "INFO"
